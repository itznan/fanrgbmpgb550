# MSI Mystic Light Motherboard USB HID Controller (e.g. MAG B550 TOMAHAWK / MPG B550 GAMING PLUS)
# VID: 0x1462 (MSI), PID: 0x7C56
# Allows non-root user access to the hidraw and usb devices for controlling motherboard lighting

SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1462", ATTRS{idProduct}=="7c56", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="1462", ATTRS{idProduct}=="7c56", MODE="0666", TAG+="uaccess"
