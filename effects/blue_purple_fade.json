{
  "name": "Dark Blue & Dark Purple Fade",
  "description": "Cyclic breathing effect that fades in and out of dark blue, fades down to black, then fades in and out of dark purple in a continuous loop",
  "author": "itznan",
  "loop": true,
  "fps": 30,
  "sync_gpu": true,
  "keyframes": [
    {
      "duration_ms": 1600,
      "transition": "linear",
      "color": "darkblue",
      "brightness": 100
    },
    {
      "duration_ms": 1200,
      "transition": "linear",
      "color": "off",
      "brightness": 0
    },
    {
      "duration_ms": 1600,
      "transition": "linear",
      "color": "darkpurple",
      "brightness": 100
    },
    {
      "duration_ms": 1200,
      "transition": "linear",
      "color": "off",
      "brightness": 0
    }
  ]
}
