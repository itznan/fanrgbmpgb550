{
  "name": "Dark Blue & Dark Purple Fade (Max Brightness 255)",
  "description": "Cyclic breathing effect that fades smoothly to full 255 dark blue, holds at peak, fades down to black, then fades to full 255 dark purple, holds at peak, and repeats",
  "author": "itznan",
  "loop": true,
  "fps": 30,
  "sync_gpu": true,
  "keyframes": [
    {
      "duration_ms": 1400,
      "transition": "linear",
      "color": [0, 20, 255],
      "brightness": 255
    },
    {
      "duration_ms": 600,
      "transition": "instant",
      "color": [0, 20, 255],
      "brightness": 255
    },
    {
      "duration_ms": 1200,
      "transition": "linear",
      "color": [0, 0, 0],
      "brightness": 0
    },
    {
      "duration_ms": 1400,
      "transition": "linear",
      "color": [130, 0, 255],
      "brightness": 255
    },
    {
      "duration_ms": 600,
      "transition": "instant",
      "color": [130, 0, 255],
      "brightness": 255
    },
    {
      "duration_ms": 1200,
      "transition": "linear",
      "color": [0, 0, 0],
      "brightness": 0
    }
  ]
}
