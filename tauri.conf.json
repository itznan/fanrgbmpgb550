{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fanrgb",
  "version": "0.1.0",
  "identifier": "com.fanrgb.app",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FanRGB - Motherboard & GPU Controller",
        "width": 960,
        "height": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
